# RHMS server environment — local only, never commit real credentials.
# Copy these keys into your own server/.env and fill in your SMTP provider values.

# SMTP email delivery (used for Forgot Password OTP emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender identity shown on outgoing mail. Falls back to the systemEmail setting.
SMTP_FROM=

# Password Reset OTP expiry in minutes
OTP_EXPIRES_MINUTES=10

# PostgreSQL connection (db.js falls back to these local defaults if unset)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rhms
DB_USER=etech
DB_PASSWORD=

# Server
PORT=5000

# Secret used to sign JWT session tokens. Set a long random value in production.
JWT_SECRET=
